# Supabase project the app reads/writes swarm_* tables in
SUPABASE_URL=https://your-project.supabase.co
# service_role key (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the member session cookie. Generate with: openssl rand -hex 32
SWARM_SESSION_SECRET=change-me
